*.tmp
*.bak
*.swp

# Python cache (if any script executed)
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE and Editor configuration
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
