# Build and Binary Artifacts
rust-core/target/
*.obj
*.o
*.pdb
*.exp
*.lib
*.ilk

# Logs and runtime traces
*.log
credprov.log
service.log
injector.log

# Sensitive credentials & vault files (CRITICAL: Never commit credentials)
